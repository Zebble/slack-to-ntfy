# Copy to .env and fill in. docker compose injects the whole file into the
# container (env_file) and also uses it for ${VAR} interpolation; the app loads
# it directly for local, non-Docker runs. The real .env is gitignored.
#
# Tokens are per-endpoint: each endpoint in config.yaml references whichever
# var you choose. Add as many as you need here — they all reach the container.

# ntfy (outbound) tokens, referenced as ${NTFY_TOKEN} / ${NTFY_TOKEN_APP} etc.
# in config.yaml. Optional but recommended; leave empty for ntfy instances
# without auth (the example omits the Authorization header when empty).
NTFY_TOKEN=
NTFY_TOKEN_APP=

# Slack (inbound) token required by endpoints that set inbound_token.
# Per-endpoint; leave empty to disable inbound auth for that endpoint.
INBOUND_TOKEN_APP=

# Host port published by docker compose (container always listens on 8080).
HOST_PORT=8080

# App logging verbosity: DEBUG / INFO / WARNING / ERROR.
LOG_LEVEL=INFO

# Seconds to wait for ntfy before giving up on a forward.
FORWARD_TIMEOUT=10

# Max inbound request body size in bytes (larger requests get a 413).
# MAX_BODY_BYTES=65536

# Comma-separated Host header allowlist for a public deployment, e.g.
# ntfy-bridge.example.com. Leave unset to accept any Host.
# ALLOWED_HOSTS=
