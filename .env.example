# Copy to .env and fill in. Loaded automatically by docker compose (for
# ${VAR} interpolation in docker-compose.yml) and by the app at startup
# (python-dotenv) for local, non-Docker runs. The real .env is gitignored.

# ntfy access token (optional but recommended), referenced as ${NTFY_TOKEN}
# in config.yaml. Leave empty for ntfy instances without auth / public topics;
# the example config omits the Authorization header when this is empty.
NTFY_TOKEN=

# Token required from inbound callers on endpoints that set inbound_token.
# Leave empty if no endpoint uses inbound_token.
INBOUND_TOKEN=

# Host port published by docker compose (container always listens on 8080).
HOST_PORT=8080

# App logging verbosity: DEBUG / INFO / WARNING / ERROR.
LOG_LEVEL=INFO

# Seconds to wait for ntfy before giving up on a forward.
FORWARD_TIMEOUT=10
